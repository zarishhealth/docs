{
  "name": "zarishhealth-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site and content checks for ZarishHealth",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "test:security": "node --test tests/security/*.test.js",
    "check": "npm run lint:md && npm run build"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mermaid-js/layout-elk": "^1.0.1",
    "braces": "file:vendor/braces",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "12.2.0"
  },
  "overrides": {
    "braces": "$braces",
    "katex": "^0.18.2",
    "postcss-selector-parser": "^7.1.6",
    "re2js": "2.8.7",
    "serialize-javascript": "^7.1.3",
    "smol-toml": "^1.9.1",
    "tinypool": "^2.2.0",
    "uuid": "^11.1.1"
  }
}
